# ====================== 目标设备 & NSS基础 ======================
CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq60xx=y
# CONFIG_TARGET_MULTI_PROFILE is not set
CONFIG_TARGET_DEVICE_qualcommax_ipq60xx_DEVICE_jdcloud_re-ss-01=y
CONFIG_TARGET_DEVICE_PACKAGES_qualcommax_ipq60xx_DEVICE_jdcloud_re-ss-01="ipq-wifi-jdcloud_re-ss-01"

CONFIG_ATH11K_MEM_PROFILE_512M=y
CONFIG_NSS_FIRMWARE_VERSION_12_5=y
# CONFIG_NSS_FIRMWARE_VERSION_11_4 is not set
# CONFIG_ATH11K_NSS_MESH_SUPPORT is not set
CONFIG_PACKAGE_wwan=y
CONFIG_PACKAGE_qca-nss-ecm=y
CONFIG_PACKAGE_qca-nss-ecm-fullcone=y
# ====================== RM500U QModem‑next 5G模组全套 ======================
# CONFIG_PACKAGE_quectel-CM-5G is not set
CONFIG_PACKAGE_luci-app-qmodem=n
CONFIG_PACKAGE_luci-app-qmodem-next=y
CONFIG_PACKAGE_luci-i18n-qmodem-next-zh-cn=y
CONFIG_PACKAGE_kmod-usb-serial=y
CONFIG_PACKAGE_kmod-usb-serial-option=y
CONFIG_PACKAGE_kmod-usb-serial-wwan=y
CONFIG_PACKAGE_kmod-qmi-wwan=y
CONFIG_PACKAGE_uqmi=y
CONFIG_PACKAGE_qmi-utils=y
CONFIG_PACKAGE_modemmanager=y
CONFIG_PACKAGE_kmod-usb-net-cdc-mbim=y
CONFIG_PACKAGE_umbim=y
CONFIG_PACKAGE_mbim-utils=y
CONFIG_PACKAGE_kmod-usb-net=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ether=y
CONFIG_PACKAGE_kmod-usb-net-qmi-wwan-fibocom=y
CONFIG_PACKAGE_kmod-usb-wdm=y
CONFIG_PACKAGE_kmod-usb-ohci=y
CONFIG_PACKAGE_kmod-usb-uhci=y
CONFIG_PACKAGE_kmod-usb2=y
CONFIG_PACKAGE_kmod-usb3=y
# ====================== SQM流控 / HomeAssistant依赖 ======================
CONFIG_PACKAGE_luci-app-sqm=y
CONFIG_PACKAGE_sqm-scripts=n
CONFIG_PACKAGE_rpcd=y
CONFIG_PACKAGE_rpcd-mod-iwinfo=y
CONFIG_PACKAGE_rpcd-mod-file=y

# ====================== LuCI中文 & 主题 ======================
CONFIG_LUCI_LANG_zh_Hans=y
CONFIG_LUCI_LANG_zh_Hant=y

CONFIG_PACKAGE_luci-app-argon-config=y
CONFIG_PACKAGE_luci-app-aurora-config=y
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-theme-aurora=y

# ====================== 网络插件 ======================
CONFIG_PACKAGE_frpc=y
CONFIG_PACKAGE_frps=y
CONFIG_PACKAGE_gecoosac=y
# CONFIG_PACKAGE_nginx-full is not set
CONFIG_PACKAGE_nginx=y
CONFIG_PACKAGE_openlist2=y
CONFIG_PACKAGE_lucky=y
CONFIG_PACKAGE_luci-app-frpc=y
CONFIG_PACKAGE_luci-app-frps=y
CONFIG_PACKAGE_luci-app-gecoosac=y
CONFIG_PACKAGE_luci-app-lucky=y
CONFIG_PACKAGE_luci-app-openlist2=y

# ====================== Aria2下载 ======================
# CONFIG_PACKAGE_aria2is not set
# CONFIG_PACKAGE_ariangis not set
# CONFIG_PACKAGE_luci-app-aria2is not set

# CONFIG_ARIA2_OPENSSLis not set
# CONFIG_ARIA2_GNUTLS is not set
# CONFIG_ARIA2_NOSSL is not set
# CONFIG_ARIA2_LIBXML2 is not set
# CONFIG_ARIA2_EXPATis not set
# CONFIG_ARIA2_NOXML is not set
# CONFIG_ARIA2_BITTORRENTis not set
# CONFIG_ARIA2_METALINKis not set
# CONFIG_ARIA2_SFTPis not set
# CONFIG_ARIA2_ASYNC_DNSis not set
# CONFIG_ARIA2_COOKIE is not set
# CONFIG_ARIA2_WEBSOCKETis not set
